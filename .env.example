# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay (server secret must never be public)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Qikink Print-on-Demand (server-only)
QIKINK_CLIENT_ID=your-qikink-client-id
QIKINK_CLIENT_SECRET=your-qikink-client-secret
QIKINK_API_BASE_URL=https://api.qikink.com/v2

# Scheduled jobs / webhook protection
CRON_SECRET=generate-a-long-random-secret
TRACKING_SYNC_SECRET=generate-a-long-random-secret
POD_WEBHOOK_SECRET=generate-a-long-random-secret

# Optional AI
HUGGINGFACE_API_TOKEN=your-huggingface-api-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development
