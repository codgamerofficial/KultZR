# NEXORA AI Digital Growth & Automation Platform — Environment Template

# Supabase PostgreSQL & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NVIDIA NIM AI Acceleration Service API (NVIDIA GLM-5.2 Model)
NVIDIA_API_KEY=your-nvidia-nim-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2

# Hugging Face AI Inference API (Secondary / Fallback Engine)
HUGGINGFACE_API_TOKEN=your-huggingface-token

# Payment Gateway Configuration (Optional Agency Retainers)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Application Environment Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development
